#!/usr/bin/env sh
detect_os() {
	[ -f /etc/os-release ] || return
	. /etc/os-release
	case $ID in
	nixos) echo "nix" ;;
	arch) echo "arch" ;;
	esac
}

stow_os_folder() {
	for path in "$1"/*/; do
		printf 'arg = %s\n' "$1"
		printf 'path = %s\n' "$path"
		name=$(basename "$path")
		printf 'name = %s\n' "$name"
		if [ "$name" = "system" ]; then
			printf 'Stowing %s into / (needs sudo)\n' "$path"
			sudo stow -t / -d "$1" -R system
		else
			stow -t "$HOME" -d "$1" -R "$name"
		fi
	done
}

for folder in "$DOTFILES_DIR"/*/; do
	[ -d "$folder" ] || continue
	name=$(basename "$folder")
	case $name in
	.* | '!'* | os_*) continue ;;
	esac
	stow -d "$DOTFILES_DIR" -R "$name"
done

os=$(detect_os)
if [ -n "$os" ] && [ -d "$DOTFILES_DIR/os_$os" ]; then
	stow_os_folder "$DOTFILES_DIR/os_$os"
fi

exec $SHELL
