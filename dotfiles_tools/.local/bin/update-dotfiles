#!/usr/bin/env sh
[ -n "$DOTFILES_DIR" ] && [ -d "$DOTFILES_DIR" ] || {
	echo "DOTFILES_DIR not set or missing" >&2
	exit 1
}

set -u

detect_os() {
	[ -f /etc/os-release ] || return
	. /etc/os-release
	case $ID in
	nixos) echo "nix" ;;
	arch) echo "arch" ;;
	esac
}

stow_folder() {
	shopt -s nullglob dotglob
	for path in "$1"/*/; do
		[ -d "$path" ] || continue
		name=$(basename "$path")
		if [ "$name" = "system" ]; then
			printf 'Stowing %s into / (needs sudo)\n' "$path"
			echo "Running command: sudo stow -t / -d \"$1\" -R system"
			sudo stow -t / -d "$1" -R system -v
		else
			[ -d "$HOME/$name" ] || {
				mkdir "$HOME/$name"
			}
			stow -t "$HOME/$name" -d "$1" -R "$name"
		fi
	done
}

os=$(detect_os)
os_dir="$DOTFILES_DIR/os_$os"
if [ -n "$os" ] && [ -d "$os_dir" ]; then
	stow_folder "$os_dir"

	if [ -f "$os_dir/exclude.txt" ]; then
		exclude_file="$os_dir/exclude.txt"
	fi

fi

for folder in "$DOTFILES_DIR"/*/; do
	[ -d "$folder" ] || continue
	name=$(basename "$folder")
	case $name in
	.* | '!'* | os_*) continue ;;
	esac

	if [ -n "${exclude_file:-}" ] && grep -qxF "$name" "$exclude_file"; then
		continue
	fi

	stow_folder "$folder"
done

exec "$SHELL"
